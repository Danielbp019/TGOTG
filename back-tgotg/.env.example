APP_NAME=Laravel
APP_ENV=local
# Clave de cifrado de la app (32 bytes en base64). SENSIBLE: se genera con "php artisan key:generate". No compartir ni commitear.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tgotg_game
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SANCTUM_STATEFUL_DOMAINS=localhost:3100,127.0.0.1:3100
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Cola de construcción (solo desarrollo) ---
# Acelera el tiempo de construcción/mejora de edificios para probar sin esperar horas.
# Cómo usar (cambia el valor y reinicia el servidor):
#   FAST_BUILD_FACTOR=0      → desactivado, tiempo real (ej: 45 min tarda 45 min).
#   FAST_BUILD_FACTOR=0.1    → 10% del tiempo (ej: 60 min → 6 min).
#   FAST_BUILD_FACTOR=0.02   → 2% del tiempo (ej: 60 min → ~1 min).
#   FAST_BUILD_FACTOR=0.01   → convierte minutos a segundos (ej: 60 min → ~5-10 s, mínimo 5 s).
# Requisitos: solo funciona con APP_DEBUG=true y APP_ENV=local. En producción déjalo en 0 o comentado.
# Alternativa sin tocar el .env (para un solo edificio): POST /api/city/buildings/{id}/upgrade?instant=1 (también requiere APP_DEBUG=true).
# Ver README > Variables de entorno para más detalles.

# FAST_BUILD_FACTOR=0


CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
